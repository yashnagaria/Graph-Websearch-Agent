# Copy to .streamlit/secrets.toml for local runs, or paste the same contents into
# Streamlit Community Cloud under: App settings -> Secrets.
#
# Only GEMINI_API_KEY is required. Without SERPER_API_KEY the app searches with
# DuckDuckGo, which needs no key.

GEMINI_API_KEY = "your-google-ai-studio-key"

# Optional - better search results (free tier at https://serper.dev/)
# SERPER_API_KEY = "your-serper-key"

# Optional - other providers
# OPENAI_API_KEY = "sk-..."
# GROQ_API_KEY = "gsk_..."
# CLAUD_API_KEY = "sk-ant-..."
